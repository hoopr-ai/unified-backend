{
  "name": "@hoopr-ai/db-schemas",
  "version": "2.0.0",
  "description": "Shared database schemas and DTOs for Hoopr backend services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "require": "./dist/enums/index.js"
    },
    "./dto": {
      "types": "./dist/dto/index.d.ts",
      "require": "./dist/dto/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "require": "./dist/models/index.js"
    }
  },
  "scripts": {
    "prepare-src": "node scripts/build.js",
    "compile": "tsc",
    "build": "npm run prepare-src && npm run compile",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoopr-ai/unified-backend.git",
    "directory": "packages/db-schemas"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "hoopr",
    "database",
    "schemas",
    "sequelize",
    "dto"
  ],
  "author": "Hoopr",
  "license": "UNLICENSED",
  "peerDependencies": {
    "sequelize": "^6.37.0",
    "sequelize-typescript": "^2.1.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5"
  }
}
