{
  "info": {
    "name": "FAQ APIs",
    "_postman_id": "faq-apis-collection",
    "description": "API collection for FAQ Sections and FAQs management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002",
      "type": "string"
    },
    {
      "key": "platform",
      "value": "CREATOR",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "FAQ Sections",
      "description": "Endpoints for managing FAQ sections",
      "item": [
        {
          "name": "Get All Sections",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/faq-sections?platform={{platform}}",
              "host": ["{{baseUrl}}"],
              "path": ["faq-sections"],
              "query": [
                {
                  "key": "platform",
                  "value": "{{platform}}",
                  "description": "Platform filter (ENTERPRISE | CREATOR)"
                }
              ]
            },
            "description": "Get all FAQ sections for a specific platform, ordered by section order"
          },
          "response": []
        },
        {
          "name": "Create Section",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"{{platform}}\",\n  \"name\": \"Getting Started\",\n  \"slug\": \"GETTING_STARTED\",\n  \"order\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/faq-sections",
              "host": ["{{baseUrl}}"],
              "path": ["faq-sections"]
            },
            "description": "Create a new FAQ section"
          },
          "response": []
        },
        {
          "name": "Update Section",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Getting Started Guide\",\n  \"order\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/faq-sections/:id",
              "host": ["{{baseUrl}}"],
              "path": ["faq-sections", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Section ID"
                }
              ]
            },
            "description": "Update an existing FAQ section"
          },
          "response": []
        },
        {
          "name": "Reorder Sections",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"{{platform}}\",\n  \"sectionOrders\": [\n    { \"id\": 1, \"order\": 3 },\n    { \"id\": 2, \"order\": 1 },\n    { \"id\": 3, \"order\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/faq-sections/reorder",
              "host": ["{{baseUrl}}"],
              "path": ["faq-sections", "reorder"]
            },
            "description": "Bulk update the order of multiple sections"
          },
          "response": []
        },
        {
          "name": "Delete Section",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/faq-sections/:id",
              "host": ["{{baseUrl}}"],
              "path": ["faq-sections", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Section ID"
                }
              ]
            },
            "description": "Soft delete a FAQ section (sets isActive to false)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "FAQs",
      "description": "Endpoints for managing FAQ questions and answers",
      "item": [
        {
          "name": "Get All FAQs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/faqs?platform={{platform}}",
              "host": ["{{baseUrl}}"],
              "path": ["faqs"],
              "query": [
                {
                  "key": "platform",
                  "value": "{{platform}}",
                  "description": "Platform filter (ENTERPRISE | CREATOR)"
                },
                {
                  "key": "sectionId",
                  "value": "1",
                  "description": "Optional: Filter by section ID",
                  "disabled": true
                }
              ]
            },
            "description": "Get all FAQs for a platform, optionally filtered by section. Results are ordered by section order, then FAQ order."
          },
          "response": []
        },
        {
          "name": "Get FAQs by Section",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/faqs?platform={{platform}}&sectionId=1",
              "host": ["{{baseUrl}}"],
              "path": ["faqs"],
              "query": [
                {
                  "key": "platform",
                  "value": "{{platform}}"
                },
                {
                  "key": "sectionId",
                  "value": "1",
                  "description": "Section ID to filter FAQs"
                }
              ]
            },
            "description": "Get FAQs for a specific section"
          },
          "response": []
        },
        {
          "name": "Create FAQ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionId\": 1,\n  \"question\": \"How do I reset my password?\",\n  \"answer\": \"You can reset your password by clicking on the 'Forgot Password' link on the login page and following the instructions sent to your email.\",\n  \"order\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/faqs",
              "host": ["{{baseUrl}}"],
              "path": ["faqs"]
            },
            "description": "Create a new FAQ under a section"
          },
          "response": []
        },
        {
          "name": "Update FAQ",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How do I reset my password?\",\n  \"answer\": \"Updated answer: You can reset your password by clicking on the 'Forgot Password' link on the login page.\",\n  \"order\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/faqs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["faqs", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "FAQ ID"
                }
              ]
            },
            "description": "Update an existing FAQ"
          },
          "response": []
        },
        {
          "name": "Move FAQ to Different Section",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionId\": 2,\n  \"order\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/faqs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["faqs", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "FAQ ID"
                }
              ]
            },
            "description": "Move a FAQ to a different section"
          },
          "response": []
        },
        {
          "name": "Reorder FAQs in Section",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionId\": 1,\n  \"faqOrders\": [\n    { \"id\": 1, \"order\": 3 },\n    { \"id\": 2, \"order\": 1 },\n    { \"id\": 3, \"order\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/faqs/reorder",
              "host": ["{{baseUrl}}"],
              "path": ["faqs", "reorder"]
            },
            "description": "Bulk update the order of FAQs within a section"
          },
          "response": []
        },
        {
          "name": "Delete FAQ",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/faqs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["faqs", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "FAQ ID"
                }
              ]
            },
            "description": "Soft delete a FAQ (sets isActive to false)"
          },
          "response": []
        }
      ]
    }
  ]
}
